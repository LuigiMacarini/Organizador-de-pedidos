{
  "expo": {
    "name": "Pedidos",
    "slug": "pedidos-lancamento-app",
    "scheme": "pedidos-lancamento",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F4F6FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.pedidoslancamento"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F6FA"
      },
      "package": "com.example.pedidoslancamento",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O ORG usa sua localização enquanto uma rota está em andamento, para mostrar sua posição no mapa e a distância até a próxima entrega."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0382c83f-d5ac-4841-961a-7bb04f97adf7"
      }
    },
    "owner": "luigimn"
  }
}
