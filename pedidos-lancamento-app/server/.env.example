# Connection string de um Postgres gerenciado gratuito (Render, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
PORT=3333

# Segredo usado para assinar os tokens JWT. Gere um valor aleatório longo,
# por exemplo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Usados apenas pelo script `npm run db:seed` para criar o primeiro usuário OWNER.
SEED_OWNER_EMAIL="dono@example.com"
SEED_OWNER_PASSWORD="troque-esta-senha"
SEED_OWNER_NAME="Dono"

# Chave gratuita do OpenRouteService (openrouteservice.org/dev/#/home), usada
# para geocodificar endereços de clientes e calcular rotas de entrega.
ORS_API_KEY="sua-chave-aqui"

# Origem padrão de uma rota de entrega, quando o entregador não informa outra
# manualmente. Geocodifique o endereço da empresa uma vez (ex.: via
# POST /v1/customers/:id/geocode com um cliente temporário, ou manualmente
# no site do OpenRouteService) e cole as coordenadas aqui.
COMPANY_ORIGIN_LAT="-23.550520"
COMPANY_ORIGIN_LNG="-46.633309"
COMPANY_ORIGIN_LABEL="Empresa"
