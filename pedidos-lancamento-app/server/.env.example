# Connection string de um Postgres gerenciado gratuito (Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
PORT=3333

# Segredo usado para assinar os tokens JWT. Gere um valor aleatório longo,
# por exemplo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Usados apenas pelo script `npm run db:seed` para criar o primeiro usuário OWNER.
SEED_OWNER_EMAIL="dono@example.com"
SEED_OWNER_PASSWORD="troque-esta-senha"
SEED_OWNER_NAME="Dono"

EXPO_PUBLIC_API_URL=http://SEU_IP_LOCAL:3333
